  ],
  "keywords": [
    "forfettario",
    "regime-forfettario",
    "flat-tax",
    "partita-iva",
    "calcolatore-tasse",
    "inps",
    "gestione-separata",
    "fisco",
    "tasse",
    "freelance",
    "italy",
    "italia",
    "tax-calculator",
    "cli",
    "typescript",
    "ateco",
    "coefficiente-di-redditivita"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "forfettario-kit": "dist/adapters/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "LICENSE",
    "NOTICE",
    "COMMERCIAL-LICENSE.md",
    "README.md",
    "README.it.md"
  ],
  "scripts": {
    "start": "node src/adapters/bin.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "core:loc": "node scripts/core-loc.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:web": "node scripts/build-web.mjs",
    "demo": "node scripts/demo-svg.mjs",
    "test:e2e": "npm run build:web && playwright test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"test/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run core:loc"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.10",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
